# Optional public settings for the marketing site in apps/web.
# The Chrome extension does not read these.
# Next.js loads env files from apps/web, so copy this file to apps/web/.env.local
# when you want to override the defaults. Leave the verification value empty locally.

# Canonical URL for metadata and the sitemap.
# When unset, the site uses https://editui.app, which redirects to https://www.editui.app.
NEXT_PUBLIC_SITE_URL=https://www.editui.app

# Chrome Web Store listing linked from the site.
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/editui/kolehloegjbpkeehflbdkjkdmljobfak

# Google Search Console verification token. Leave empty locally.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
